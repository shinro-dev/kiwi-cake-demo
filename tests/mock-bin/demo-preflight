#!/usr/bin/env bash
# Test double for demo-preflight (see README.md). Not Cake.
set -uo pipefail
if printf '%s\n' "$@" | grep -qx -- '--list-checks'; then
  printf 'page-size\nglibc\nmemfd-noexec\nadmission\nload-probe\nobserver\nshipped-binaries\n'; exit 0
fi
[ $# -gt 0 ] || { echo "demo-preflight: REFUSED: --capsule is required" >&2; exit 1; }
echo "demo-preflight: tested board record Raspberry Pi 5 Model B Rev 1.0 page_size 16384 glibc 2.41"
echo "demo-preflight: active profile page_size 16384 libc_min 2.34 allowed_dependencies libc.so.6"
echo "demo-preflight: page size 16384"
echo "demo-preflight: glibc 2.41"
echo "demo-preflight: vm.memfd_noexec_scope absent on this kernel"
echo "demo-preflight: check admission the staged capsule is admitted against the active profile"
echo "demo-preflight: module pt load alignment 0x10000"
echo "demo-preflight: check load-probe mapped through the sealed loader path with 4 seals and resolved the entry symbol"
echo "demo-preflight: REFUSED: check observer: --observer-module was not given, so the module this board builds for itself would first be exercised by the resident; that is the divergence this check exists to close" >&2
exit 1
