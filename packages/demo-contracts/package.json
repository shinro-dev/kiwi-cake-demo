{
  "name": "@kiwi/demo-contracts",
  "version": "1.7.0",
  "private": true,
  "description": "Operator console contract v1: JSON Schema source of truth, synthetic fixtures, a dependency-free Python validator and generated TypeScript types.",
  "license": "BUSL-1.1",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.4.1",
  "types": "./ts/generated.ts",
  "exports": {
    ".": {
      "types": "./ts/generated.ts",
      "default": "./ts/generated.ts"
    },
    "./schema/v1/*.json": "./schema/v1/*.json",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check": "node scripts/generate.mjs --check"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4"
  }
}
