#!/bin/bash
# Copyright 2026 Shinro SAS. Licensed under the Business Source License 1.1; see LICENSE.
#
# run-child.sh: the child command the Cake supervisor spawns in segment 2.
#
# The supervisor's --child-command names a path and execs it directly, with
# no interpreter prepended, so a bare Python entry point needs this wrapper.
# It uses exec (not a fork) so the supervisor's pid tracking points at the
# actual Python process and not at a lingering shell.
#
# The supervisor invokes any child with four positional arguments of its own
# (<child_lines> <child_exit_status> <child_hold_units> <run_tag>), which
# mean nothing to a LeRobot host's argument parser. Forwarding "$@" was the
# first mistake of the original demo run: the host rejected them as
# unrecognized and exited before the robot was ever opened, five times, until
# the supervisor's restart bound was reached. The real robot flags are
# hardcoded below instead, and the four positionals are ignored on purpose.
#
# Replace every @@PLACEHOLDER@@ with your own values. The demo runner refuses
# to start while any placeholder remains.
#
#   @@PYTHON@@             the interpreter of the environment where LeRobot is installed (absolute path)
#   @@HOST_ENTRY@@         the absolute path of bin/pi/lekiwi_host_noninteractive.py in this checkout
#                          (the same path inside an extracted release archive): the stock LeKiwi
#                          host minus its calibration prompt, which crash-loops under the supervisor.
#                          bin/templates/run-child.sh.example is this template filled in.
#   @@ROBOT_ID@@           the robot id you calibrated with
#   @@ROBOT_PORT@@         the serial port, preferably a /dev/serial/by-id/ path
#   @@CAMERAS_JSON@@       the camera configuration your host expects, as one JSON object
#   @@CONNECTION_TIME_S@@  how long the host serves before exiting on its own
exec @@PYTHON@@ @@HOST_ENTRY@@ \
  --robot.id=@@ROBOT_ID@@ \
  --robot.port=@@ROBOT_PORT@@ \
  --robot.max_relative_target=15.0 \
  --robot.disable_torque_on_disconnect=true \
  --robot.cameras='@@CAMERAS_JSON@@' \
  --host.connection_time_s=@@CONNECTION_TIME_S@@
